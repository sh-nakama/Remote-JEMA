# === Required ===
WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK
HF_TOKEN=hf_YOUR_TOKEN_HERE
HF_DATASET_REPO=your-username/repower-data

# === Optional (deferred – LLM layer) ===
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MONTHLY_CAP_USD=5.00

# === Policy observer (NotebookLM summarisation) ===
# NOTEBOOKLM_TIER drives the per-notebook source cap (standard=50, plus=100,
# pro=300, ultra=600). NOTEBOOKLM_BIN points at the notebooklm CLI when it is not
# on PATH. NOTEBOOKLM_AUTH_JSON (CI only) holds the storage_state.json contents
# from a `notebooklm login` — set as a GitHub secret, not committed here.
# NOTEBOOKLM_TIER=standard
# NOTEBOOKLM_BIN=notebooklm

# === Weekly summary email (`repower policy weekly`) ===
# SMTP over implicit TLS; defaults suit Gmail with an App Password.
# SMTP_USER=sender@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# MAIL_TO=you@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM=

# === Overrides ===
# REPOWER_DB_PATH=data/repower.db
